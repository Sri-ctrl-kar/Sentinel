# Sentinel environment variables
#
# Copy to .env and fill in what you need. Nothing here is required: Sentinel
# runs end to end with the deterministic mock reasoner and no credentials.
# Values already exported in your shell always win over this file.

# --- AI incident intelligence (M0.7) ---------------------------------------
# Which incident reasoner to build by default: "mock" (deterministic template,
# no network) or "anthropic".
SENTINEL_REASONER=mock

# Model used by the anthropic provider.
SENTINEL_REASONER_MODEL=claude-opus-5

# Generation limits for the AI layer.
SENTINEL_REASONER_MAX_TOKENS=2000
SENTINEL_REASONER_TIMEOUT_SECONDS=60

# Required only by the anthropic provider. Never commit a real key.
ANTHROPIC_API_KEY=
